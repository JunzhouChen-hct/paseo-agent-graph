{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "@getpaseo/plugin": ["node_modules/@getpaseo/plugin/dist/index.d.ts"],
      "@getpaseo/plugin/*": ["node_modules/@getpaseo/plugin/dist/*"],
      "@getpaseo/client": ["node_modules/@getpaseo/client/dist/index.d.ts"],
      "@getpaseo/client/*": ["node_modules/@getpaseo/client/dist/*"]
    }
  },
  "include": ["*.ts"]
}
